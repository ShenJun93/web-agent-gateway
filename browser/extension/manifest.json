{
  "manifest_version": 3,
  "name": "WAG Browser Adapter",
  "version": "0.0.1",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["nativeMessaging", "sidePanel", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
