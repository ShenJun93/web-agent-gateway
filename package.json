{
  "name": "web-agent-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <27"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:native-host": "tsx scripts/build-native-host.ts",
    "test:business": "npm run build && tsx --test --test-concurrency=1 test/business-stdio.acceptance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
