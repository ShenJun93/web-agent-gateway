{
  "name": "web-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19 <27"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:native-host": "tsx scripts/build-native-host.ts",
    "verify:native-host-licenses": "tsx scripts/verify-native-host-license-compliance.ts",
    "record:native-host-candidate": "tsx scripts/record-native-host-unsigned-candidate.ts",
    "verify:native-host-candidate": "tsx scripts/verify-signed-native-host-candidate.ts",
    "test:business": "npm run build && tsx --test --test-concurrency=1 test/business-stdio.acceptance.ts",
    "test:dc-replacement": "npm run build && tsx --test --test-concurrency=1 test/dc-replacement.acceptance.ts",
    "test:operator-browser": "tsx scripts/verify-operator-browser-origin.ts",
    "operator:open": "tsx scripts/open-operator.ts",
    "lease:stop": "tsx scripts/lease-stop.ts",
    "test:goal-lease": "npm run build && tsx --test --test-concurrency=1 test/goal-lease-e2e.acceptance.ts",
    "p1a:tools": "tsx scripts/p1a-tool-inventory.ts",
    "p1a:snapshot": "tsx scripts/p1a-state-snapshot.ts",
    "test:delegation-mutations": "tsx scripts/delegation-mutation-battery.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "resedit": "3.1.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
